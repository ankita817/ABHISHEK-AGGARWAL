class Solution {
public:
    bool isAnagram(string s, string t) { 

        if(s.size() != t.size()){
            return false;
        }
        
        
        sort(s.begin(), s.end());
        sort(t.begin(), t.end());

        if(s == t) {
            return true;
        }else{
            return false;
        }
    }
};
        
        

#include <iostream>
using namespace std;

bool isPalindrome(string str) {
    int start = 0;
    int end = str.size() -1;
    while(start < end) {
        if(str[start] != str[end]){
            return false;
        }
        start++;
        end--;
    }
    return true;
}

int main()
{
    string str;
    cout << "Enter a string...";
    cin >> str;
    
    if(isPalindrome(str)){
        cout << "given string is a Palindrome string...";
    } else {
        cout <<" given string is not a Palindrome...";
    }
    
 return 0;
}
        



        
    


        
    
