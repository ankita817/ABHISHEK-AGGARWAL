//problem no 5
//swapping of 2 variable's value using pointers and using functions
#include<iostream>
using namespace std;


int main(){
    int a = 5, b = 10;
    
    int *p = &a;
    int *q = &b;
    
    int temp = *p;
    *p = *q;
    *q = temp;
    
    cout <<"After swapping :\n";
    cout <<"a = " << a <<", b = "<< b;
    
    return 0 ;
    
}


